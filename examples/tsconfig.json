{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["DOM", "ESNext"],
    "paths": {
      "react-helmet-pro": ["../src/index.ts"],
      "react-helmet-pro/*": ["../src/*/index.ts", "../src/server/*.ts"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./*.ts", "./*.tsx"],
  "exclude": ["./node_modules", "./vite.config.examples.ts"]
}
